Sub 读取运行配置()
    操作超时秒数 = 读取范围数字("操作超时秒数", 120, 30, 600)
    登录超时秒数 = 读取范围数字("登录超时秒数", 600, 30, 3600)
    邮件间隔秒数 = 读取范围数字("邮件间隔秒数", 21600, 30, 86400)
    立即检查邮件 = ReadUIConfig("立即检查邮件", False)
End Sub

Function 读取范围数字(配置名, 默认值, 最小值, 最大值)
    Dim 原值, 数值
    原值 = CDbl(ReadUIConfig(配置名, 默认值))
    数值 = 默认值
    If IsNumeric(原值) Then
        数值 = Int(CDbl(原值))
    End If
    If 数值 < 最小值 Then
        数值 = 最小值
    End If
    If 数值 > 最大值 Then
        数值 = 最大值
    End If
    读取范围数字 = 数值
End Function

