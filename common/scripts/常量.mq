// 助手3.8使用已核对的Dim赋值，不依赖未经确认的Const声明。
Sub 初始化常量()
    任务成功 = 1
    任务等待 = 0
    任务失败 = -1
    任务超时 = -2
    游戏包名 = "com.tencent.tmgp.dragonball"
    当前阶段 = "初始化"
    最近页面 = ""
    最后进展时间 = TickCount()
    登录计时中 = False
    登录计时起点 = 0
    登录等待原因 = ""
    登录提示时间 = -10000
    上次点击时间 = -3000
    大厅连续帧 = 0
    上次大厅帧时间 = -1000
    当前任务状态 = -1
    本轮是否已提交 = False
    邮件终态已确认 = False
End Sub

