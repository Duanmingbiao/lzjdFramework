// Module: common/scripts/页面识别.mq
Function 识别绿色返回箭头()
    识别绿色返回箭头 = True
    If 查找图色("绿色返回一") Then
        Exit Function
    End If
    识别绿色返回箭头 = 查找图色("绿色返回二")
End Function

Function 识别已知遮挡()
    识别已知遮挡 = 查找图色("获得奖励") Or 查找图色("邮件关闭弹窗") Or 查找图色("关闭一") Or 查找图色("关闭二") Or 查找图色("关闭三") Or 查找图色("我知道了") Or 查找图色("回归公告")
End Function

Function 大厅当前帧成立()
    大厅当前帧成立 = False
    If Not 游戏位于前台() Then
        Exit Function
    End If
    ReleaseCapture
    KeepCapture
    // 原版这两组是大厅底部的布局候选，不错误地要求两种样式同时出现。
    If 查找图色("大厅主体") Or 查找图色("大厅底部") Then
        If Not 识别绿色返回箭头() And Not 识别已知遮挡() Then
            大厅当前帧成立 = True
        End If
    End If
    ReleaseCapture
End Function

Function 确认当前在大厅()
    确认当前在大厅 = False
    If TickCount() - 上次大厅帧时间 < 400 Then
        Exit Function
    End If
    上次大厅帧时间 = TickCount()
    If 大厅当前帧成立() Then
        大厅连续帧 = 大厅连续帧 + 1
    Else
        大厅连续帧 = 0
    End If
    确认当前在大厅 = 大厅连续帧 >= 2
End Function

Function 等待确认大厅()
    大厅连续帧 = 0
    上次大厅帧时间 = TickCount() - 500
    等待确认大厅 = False
    If 确认当前在大厅() Then
        等待确认大厅 = True
        Exit Function
    End If
    Delay 500
    等待确认大厅 = 确认当前在大厅()
End Function

Function 处理已知弹窗()
    处理已知弹窗 = False
    If Not 游戏位于前台() Then
        Exit Function
    End If
    ReleaseCapture
    If 点击匹配图色("获得奖励", "关闭获得奖励") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("邮件关闭弹窗", "关闭邮件弹窗") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("我知道了", "我知道了") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("回归公告", "关闭回归公告") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("关闭一", "关闭活动弹窗一") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("关闭二", "关闭活动弹窗二") Then
        处理已知弹窗 = True
    ElseIf 点击匹配图色("关闭三", "关闭活动弹窗三") Then
        处理已知弹窗 = True
    End If
End Function

Function 识别邮件页面()
    识别邮件页面 = 查找图色("邮件空一") Or 查找图色("邮件空二") Or 查找图色("邮件可领一") Or 查找图色("邮件可领二")
End Function



// Module: common/scripts/返回大厅.mq
Function 返回大厅()
    Dim 起点, 箭头存在, 上帧标识
    返回大厅 = 任务失败
    起点 = TickCount()
    上帧标识 = ""
    大厅连续帧 = 0
    Call 设置任务状态(2, "返回大厅中")
    Call 开始操作阶段("返回大厅")
    Do
        If Not 游戏是否运行() Or Not 游戏位于前台() Then
            Exit Function
        End If
        If 确认当前在大厅() Then
            Call 标记操作进展("大厅已连续两帧确认")
            返回大厅 = 任务成功
            Exit Function
        End If
        If 处理已知弹窗() Then
            Call 观察到页面("返回过程存在弹窗")
        Else
            箭头存在 = 识别绿色返回箭头()
            If 箭头存在 Then
                Call 观察到页面("返回箭头可见")
                If 点击游戏坐标(命中X, 命中Y, "绿色箭头返回") Then
                    Delay 500
                End If
            ElseIf 大厅当前帧成立() Then
                Call 观察到页面("返回后大厅候选")
            End If
        End If
        If 操作是否超时() Or TickCount() - 起点 > 180000 Then
            返回大厅 = 任务超时
            Exit Function
        End If
        Delay 500
    Loop
End Function



// Module: common/scripts/任务状态.mq
Sub 读取任务状态()
    下次邮件时间 = 0
    邮件失败次数 = ReadConfig("最小闭环.邮件.失败次数", 0)
    If ReadConfig("最小闭环.邮件.提交有效", False) Then
        下次邮件时间 = ReadConfig("最小闭环.邮件.下次执行时间", 0)
    End If
    If ReadConfig("最小闭环.邮件.未完成", False) Then
        下次邮件时间 = 0
        Call 写日志("恢复上次未完成邮件，从任务入口重新执行")
    End If
End Sub

Sub 设置任务状态(新状态, 描述)
    If 当前任务状态 <> 新状态 Then
        当前任务状态 = 新状态
        Call 写日志("状态=" & 新状态 & "，" & 描述)
        WriteConfig "最小闭环.当前任务编号", 当前任务编号, True
        WriteConfig "最小闭环.当前状态", 新状态, True
        WriteConfig "最小闭环.当前阶段", 描述, True
    End If
End Sub

Sub 开始邮件记录()
    本轮开始时间 = Time()
    本轮是否已提交 = False
    邮件终态已确认 = False
    邮件终态说明 = ""
    邮件领取尝试次数 = 0
    WriteConfig "最小闭环.邮件.未完成", True, True
    WriteConfig "最小闭环.邮件.最后开始时间", 本轮开始时间, True
    WriteConfig "最小闭环.邮件.是否启用", True, True
    Call 设置任务状态(1, "邮件执行中")
End Sub

Sub 提交邮件完成()
    Dim 已完成次数
    // 成功返回值之外再检查终态与大厅，禁止在领取点击后提前提交。
    If Not 邮件终态已确认 Or 本轮是否已提交 Then
        Exit Sub
    End If
    If Not 等待确认大厅() Then
        Call 恢复未完成任务(任务失败)
        Exit Sub
    End If
    下次邮件时间 = Time() + 邮件间隔秒数
    已完成次数 = ReadConfig("最小闭环.邮件.完成轮次", 0) + 1
    WriteConfig "最小闭环.邮件.提交有效", False, True
    WriteConfig "最小闭环.邮件.任务编号", 168, True
    WriteConfig "最小闭环.邮件.所属日期", Date(), True
    WriteConfig "最小闭环.邮件.最后完成时间", Time(), True
    WriteConfig "最小闭环.邮件.下次执行时间", 下次邮件时间, True
    WriteConfig "最小闭环.邮件.完成轮次", 已完成次数, True
    WriteConfig "最小闭环.邮件.终态", 邮件终态说明, True
    WriteConfig "最小闭环.邮件.领取尝试次数", 邮件领取尝试次数, True
    WriteConfig "最小闭环.邮件.未完成", False, True
    WriteConfig "最小闭环.邮件.提交有效", True, True
    本轮是否已提交 = True
    Call 设置任务状态(4, "本轮完成，等待下一次邮件检查")
    Call 写日志("闭环完成：" & 邮件终态说明 & "；下次执行时间戳=" & 下次邮件时间)
    ShowMessage "邮件检查完成，已回大厅并记录，等待下一轮"
End Sub



// Module: common/scripts/任务分派.mq
Function 执行指定任务(任务编号)
    执行指定任务 = 任务失败
    Select Case 任务编号
    Case 1
        执行指定任务 = 执行游戏重连()
    Case 168
        执行指定任务 = 执行邮件任务()
    End Select
End Function

Sub 恢复未完成任务(失败结果)
    If 当前任务编号 = 1 Then
        // 登录只能在统一登录期限耗尽且仍未确认大厅时重启游戏。
        If Not 登录是否超时() Then
            Call 提示登录等待("登录尚未超时，继续等待，不重启游戏")
            Exit Sub
        End If
    End If
    邮件失败次数 = 邮件失败次数 + 1
    WriteConfig "最小闭环.邮件.失败次数", 邮件失败次数, True
    WriteConfig "最小闭环.邮件.未完成", True, True
    WriteConfig "最小闭环.最后失败任务", 当前任务编号, True
    WriteConfig "最小闭环.最后失败结果", 失败结果, True
    Call 设置任务状态(6, "未完成，关闭游戏后从入口恢复")
    Call 写日志("统一恢复；失败结果=" & 失败结果 & "；累计失败=" & 邮件失败次数)
    ReleaseCapture
    KillApp 游戏包名
    Delay 3000
    登录计时中 = False
    大厅连续帧 = 0
    下次邮件时间 = 0
    // 下一轮先分派重连，再从邮件入口执行；不恢复旧坐标、不递归调用。
End Sub



// Module: flows/001_游戏重连/scripts/启动游戏.mq
Sub 启动游戏()
    // 已在授权界面时不把游戏强行切回前台，也不关闭QQ。
    If 正在外部授权() Then
        Call 提示登录等待("已在外部授权，继续处理授权")
        Exit Sub
    End If
    If 游戏位于前台() Then
        Exit Sub
    End If
    Call 标记操作进展("请求启动游戏")
    RunApp 游戏包名
    // RunApp只发起启动；是否真正进入大厅由登录循环判定。
End Sub


// Module: flows/001_游戏重连/scripts/登录游戏.mq
Function 点击QQ授权坐标(X, Y, 动作名)
    Dim 前台包名
    点击QQ授权坐标 = False
    If 登录是否超时() Then
        Exit Function
    End If
    前台包名 = Sys.GetFront()
    // 授权图色可在QQ原生页面和游戏内授权网页中出现。
    If 前台包名 <> 游戏包名 And 前台包名 <> "com.tencent.mobileqq" Then
        Exit Function
    End If
    If X < 0 Or X >= 720 Or Y < 0 Or Y >= 1280 Then
        Exit Function
    End If
    ReleaseCapture
    Tap X, Y
    大厅连续帧 = 0
    上次点击时间 = TickCount()
    Call 写日志("QQ授权操作：" & 动作名 & "，坐标=" & X & "," & Y)
    Delay 1000
    点击QQ授权坐标 = True
End Function

Function 处理QQ授权()
    Dim 前台包名, 锚点X, 锚点Y
    处理QQ授权 = False
    前台包名 = Sys.GetFront()
    If 前台包名 <> 游戏包名 And 前台包名 <> "com.tencent.mobileqq" Then
        Exit Function
    End If
    ReleaseCapture
    // root.793：QQ授权登录、VIP信息确定、同意/拒绝三个分支。
    If 查找图色("QQ授权登录一") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "授权登录")
    ElseIf 查找图色("QQ授权登录二") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "授权登录或确认")
    ElseIf 查找图色("QQ授权确认") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "确认QQ授权信息")
    ElseIf 查找图色("QQ授权同意") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "同意QQ授权")
    ElseIf 查找图色("QQ一键登录") Then
        // root.793：先点(x-151,y+86)，等1秒，再点(x+63,y)。
        锚点X = 命中X
        锚点Y = 命中Y
        If 点击QQ授权坐标(锚点X - 151, 锚点Y + 86, "一键登录协议") Then
            处理QQ授权 = 点击QQ授权坐标(锚点X + 63, 锚点Y, "QQ一键登录")
        End If
    ElseIf 查找图色("QQ旧版授权一") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "QQ授权继续一")
    ElseIf 查找图色("QQ旧版授权二") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "QQ授权继续二")
    ElseIf 查找图色("QQ旧版授权三") Then
        处理QQ授权 = 点击QQ授权坐标(命中X, 命中Y, "QQ授权继续三")
    End If
End Function

Function 登录游戏()
    Dim 协议尝试
    登录游戏 = 任务超时
    协议尝试 = 0
    Call 开始登录计时()
    Call 开始操作阶段("处理登录、QQ授权与公告")
    Do
        // 只有大厅成功或统一期限耗尽才退出；前台切换不返回失败。
        If 确认当前在大厅() Then
            登录计时中 = False
            Call 标记操作进展("登录结束，大厅已确认")
            登录游戏 = 任务成功
            Exit Function
        End If
        If 登录是否超时() Then
            Call 写日志("登录到大厅超时，尚未确认主页；交给顶层重启恢复")
            Exit Function
        End If
        If 处理QQ授权() Then
            Call 提示登录等待("已处理QQ授权按钮，等待页面返回")
        ElseIf 游戏位于前台() Then
            If 处理已知弹窗() Then
                Call 提示登录等待("处理游戏公告和活动弹窗")
            ElseIf 查找图色("QQ登录页") Then
                If 查找图色("协议已选") Then
                    If 点击匹配图色("QQ登录页", "QQ登录") Then
                        Call 提示登录等待("已点击QQ登录，等待授权")
                        Delay 1500
                    End If
                ElseIf 协议尝试 < 1 Then
                    If 点击游戏坐标(45, 1150, "勾选QQ登录协议") Then
                        协议尝试 = 协议尝试 + 1
                        Delay 1000
                    End If
                Else
                    Call 提示登录等待("等待登录协议选中，尚未到登录超时")
                End If
            ElseIf 点击匹配图色("开始游戏", "开始游戏，使用当前已选区服") Then
                Call 提示登录等待("进入当前区服，等待大厅")
                Delay 1500
            ElseIf 识别绿色返回箭头() Then
                // 不调用受普通操作超时约束的公共返回流程。
                If 点击游戏坐标(命中X, 命中Y, "登录过程返回主页") Then
                    Call 提示登录等待("已点击返回，继续等待主页")
                End If
            Else
                Call 提示登录等待("等待游戏加载或页面识别")
            End If
        Else
            // 未识别的授权网页/确认页也等待，不因包名切换而失败。
            Call 提示登录等待("等待QQ授权或返回游戏，未确认主页")
        End If
        Delay 500
    Loop
End Function


// Module: flows/001_游戏重连/scripts/游戏重连.mq
Function 执行游戏重连()
    执行游戏重连 = 任务失败
    Call 设置任务状态(0, "准备检测游戏")
    If 等待确认大厅() Then
        登录计时中 = False
        执行游戏重连 = 任务成功
        Exit Function
    End If
    Call 开始登录计时()
    // 启动、加载、QQ授权、确认和回到游戏共用一个登录期限。
    Call 启动游戏()
    执行游戏重连 = 登录游戏()
End Function


// Module: flows/168_领邮件奖励/scripts/领邮件奖励.mq
Function 进入邮件页面()
    Dim 起点, 入口已点, 上次入口时间
    进入邮件页面 = 任务失败
    If Not 等待确认大厅() Then
        Exit Function
    End If
    Call 开始操作阶段("进入邮件页面")
    起点 = TickCount()
    入口已点 = 0
    上次入口时间 = -3000
    Do
        If Not 游戏位于前台() Then
            Exit Function
        End If
        If 识别邮件页面() Then
            Call 标记操作进展("邮件页面已确认")
            进入邮件页面 = 任务成功
            Exit Function
        End If
        If 处理已知弹窗() Then
            Call 观察到页面("邮件入口弹窗")
        ElseIf 点击匹配图色("低客户端提示", "关闭低客户端提示") Then
            Call 观察到页面("低客户端提示")
        ElseIf 大厅当前帧成立() And 入口已点 < 3 Then
            If TickCount() - 上次入口时间 > 2500 Then
                // V5.510 root.728入口坐标，仅在大厅已确认时使用。
                If 点击游戏坐标(25, 830, "打开邮件入口") Then
                    入口已点 = 入口已点 + 1
                    上次入口时间 = TickCount()
                End If
            End If
        End If
        If 操作是否超时() Or TickCount() - 起点 > 180000 Then
            进入邮件页面 = 任务超时
            Exit Function
        End If
        Delay 500
    Loop
End Function

Function 领取邮件奖励()
    Dim 起点, 空状态连续帧, 当前可领, 当前为空, 按钮X, 按钮Y
    领取邮件奖励 = 任务失败
    空状态连续帧 = 0
    起点 = TickCount()
    Call 开始操作阶段("检查邮件奖励")
    Do
        If Not 游戏位于前台() Then
            Exit Function
        End If
        ReleaseCapture
        KeepCapture
        当前可领 = 查找图色("邮件可领一")
        If Not 当前可领 Then
            当前可领 = 查找图色("邮件可领二")
        End If
        按钮X = 命中X + 319
        按钮Y = 命中Y - 90
        当前为空 = 查找图色("邮件空一") Or 查找图色("邮件空二")
        ReleaseCapture
        If 处理已知弹窗() Then
            空状态连续帧 = 0
            Call 观察到页面("邮件奖励弹窗")
        ElseIf 当前可领 Then
            空状态连续帧 = 0
            Call 观察到页面("邮件可领取")
            // 锚点来自邮件整页多点模板，禁止单独按橙色像素点击。
            If 点击游戏坐标(按钮X, 按钮Y, "一键领取邮件奖励") Then
                邮件领取尝试次数 = 邮件领取尝试次数 + 1
            End If
        ElseIf 当前为空 Then
            空状态连续帧 = 空状态连续帧 + 1
            Call 观察到页面("邮件已无可领取奖励")
            If 空状态连续帧 >= 2 Then
                邮件终态已确认 = True
                If 邮件领取尝试次数 > 0 Then
                    邮件终态说明 = "已尝试领取，确认无可领取奖励"
                Else
                    邮件终态说明 = "本轮检查无可领取奖励"
                End If
                领取邮件奖励 = 任务成功
                Exit Function
            End If
        Else
            空状态连续帧 = 0
        End If
        If 操作是否超时() Or TickCount() - 起点 > 180000 Then
            领取邮件奖励 = 任务超时
            Exit Function
        End If
        Delay 500
    Loop
End Function

Function 执行邮件任务()
    Dim 结果
    执行邮件任务 = 任务失败
    Call 开始邮件记录()
    结果 = 进入邮件页面()
    If 结果 <> 任务成功 Then
        执行邮件任务 = 结果
        Exit Function
    End If
    结果 = 领取邮件奖励()
    If 结果 <> 任务成功 Then
        执行邮件任务 = 结果
        Exit Function
    End If
    结果 = 返回大厅()
    If 结果 <> 任务成功 Then
        执行邮件任务 = 结果
        Exit Function
    End If
    执行邮件任务 = 任务成功
End Function

