// Module: app/入口.mq
// 最小闭环 v0.2：QQ自动授权，登录到大厅使用独立总超时。
Dim 任务成功, 任务等待, 任务失败, 任务超时
Dim 游戏包名, 操作超时秒数, 登录超时秒数, 邮件间隔秒数
Dim 当前阶段, 最后进展时间, 最近页面, 命中X, 命中Y
Dim 大厅连续帧, 上次大厅帧时间, 下次邮件时间, 邮件失败次数
Dim 当前任务编号, 当前任务状态, 上次点击时间
Dim 登录计时中, 登录计时起点, 登录等待原因, 登录提示时间
Dim 邮件终态已确认, 邮件终态说明, 邮件领取尝试次数
Dim 本轮结果, 本轮开始时间, 本轮是否已提交, 立即检查邮件

Call 初始化常量()
Log.Open
Call 读取运行配置()
Call 读取任务状态()
Call 写日志("最小闭环 v0.2 启动；登录到大厅超时=" & 登录超时秒数 & "秒")
If GetScreenX() <> 720 Or GetScreenY() <> 1280 Then
    Call 写日志("分辨率不符合：需要720x1280，请调整模拟器后再运行")
    ShowMessage "请设置为720x1280、320 DPI后重新运行"
    EndScript
End If
If 立即检查邮件 Then
    下次邮件时间 = 0
End If
Do
    If Time() >= 下次邮件时间 Then
        当前任务编号 = 1
        本轮结果 = 执行指定任务(1)
        If 本轮结果 = 任务成功 Then
            当前任务编号 = 168
            本轮结果 = 执行指定任务(168)
            If 本轮结果 = 任务成功 Then
                Call 提交邮件完成()
            ElseIf 本轮结果 <> 任务等待 Then
                Call 恢复未完成任务(本轮结果)
            End If
        ElseIf 本轮结果 <> 任务等待 Then
            Call 恢复未完成任务(本轮结果)
        End If
    Else
        Call 设置任务状态(4, "邮件等待下一轮")
    End If
    Delay 1000
Loop



// Module: common/scripts/常量.mq
// 助手3.8使用已核对的Dim赋值，不依赖未经确认的Const声明。
Sub 初始化常量()
    任务成功 = 1
    任务等待 = 0
    任务失败 = -1
    任务超时 = -2
    游戏包名 = "com.tencent.tmgp.dragonball"
    当前阶段 = "初始化"
    最近页面 = ""
    最后进展时间 = TickCount()
    登录计时中 = False
    登录计时起点 = 0
    登录等待原因 = ""
    登录提示时间 = -10000
    上次点击时间 = -3000
    大厅连续帧 = 0
    上次大厅帧时间 = -1000
    当前任务状态 = -1
    本轮是否已提交 = False
    邮件终态已确认 = False
End Sub



// Module: common/scripts/日志.mq
Sub 写日志(内容)
    TracePrint Time() & " | 任务=" & 当前任务编号 & " | " & 内容
End Sub



// Module: common/scripts/配置读取.mq
Sub 读取运行配置()
    操作超时秒数 = 读取范围数字("操作超时秒数", 120, 30, 600)
    登录超时秒数 = 读取范围数字("登录超时秒数", 600, 30, 3600)
    邮件间隔秒数 = 读取范围数字("邮件间隔秒数", 21600, 30, 86400)
    立即检查邮件 = ReadUIConfig("立即检查邮件", False)
End Sub

Function 读取范围数字(配置名, 默认值, 最小值, 最大值)
    Dim 原值, 数值
    原值 = CDbl(ReadUIConfig(配置名, 默认值))
    数值 = 默认值
    If IsNumeric(原值) Then
        数值 = Int(CDbl(原值))
    End If
    If 数值 < 最小值 Then
        数值 = 最小值
    End If
    If 数值 > 最大值 Then
        数值 = 最大值
    End If
    读取范围数字 = 数值
End Function



// Module: common/scripts/运行计时.mq
Sub 开始操作阶段(阶段)
    最近页面 = ""
    Call 标记操作进展(阶段)
End Sub

Sub 标记操作进展(阶段)
    当前阶段 = 阶段
    最后进展时间 = TickCount()
    Call 写日志(阶段)
    WriteConfig "最小闭环.当前阶段", 阶段, True
End Sub

Sub 观察到页面(页面名)
    If 最近页面 <> 页面名 Then
        最近页面 = 页面名
        Call 标记操作进展("识别页面：" & 页面名)
    End If
End Sub

Function 操作是否超时()
    操作是否超时 = TickCount() - 最后进展时间 > 操作超时秒数 * 1000
End Function

Sub 开始登录计时()
    // 一个重连周期只起算一次，切换QQ、确认页、游戏都不重新起算。
    If Not 登录计时中 Then
        登录计时中 = True
        登录计时起点 = TickCount()
        登录等待原因 = ""
        登录提示时间 = TickCount() - 10000
        Call 写日志("开始登录计时，直到确认大厅；上限=" & 登录超时秒数 & "秒")
    End If
End Sub

Function 登录是否超时()
    登录是否超时 = False
    If 登录计时中 Then
        登录是否超时 = TickCount() - 登录计时起点 >= 登录超时秒数 * 1000
    End If
End Function

Sub 提示登录等待(原因)
    Dim 已用秒数
    If 原因 <> 登录等待原因 Or TickCount() - 登录提示时间 >= 10000 Then
        登录等待原因 = 原因
        登录提示时间 = TickCount()
        已用秒数 = Int((TickCount() - 登录计时起点) / 1000)
        Call 写日志(原因 & "；登录已用=" & 已用秒数 & "秒/" & 登录超时秒数 & "秒；前台=" & Sys.GetFront())
    End If
End Sub



// Module: common/scripts/游戏控制.mq
Function 游戏是否运行()
    游戏是否运行 = Sys.IsRunning(游戏包名)
End Function

Function 游戏位于前台()
    游戏位于前台 = Sys.AppIsFront(游戏包名)
End Function

Function 正在外部授权()
    Dim 前台包名
    前台包名 = Sys.GetFront()
    正在外部授权 = 前台包名 = "com.tencent.mobileqq" Or 前台包名 = "com.tencent.mm"
End Function



// Module: common/scripts/点击操作.mq
Function 点击游戏坐标(X, Y, 动作名)
    点击游戏坐标 = False
    If Not 游戏位于前台() Then
        Exit Function
    End If
    If X < 0 Or X >= 720 Or Y < 0 Or Y >= 1280 Then
        Call 写日志("拒绝越界点击：" & 动作名)
        Exit Function
    End If
    If TickCount() - 上次点击时间 < 800 Then
        Exit Function
    End If
    ReleaseCapture
    Tap X, Y
    上次点击时间 = TickCount()
    大厅连续帧 = 0
    Call 写日志("尝试点击：" & 动作名 & "，坐标=" & X & "," & Y)
    // 点击不等于进展；由后续页面改变来重置计时，避免卡住时一直续时。
    Delay 500
    点击游戏坐标 = True
End Function

Function 点击匹配图色(图色名, 动作名)
    点击匹配图色 = False
    If 查找图色(图色名) Then
        点击匹配图色 = 点击游戏坐标(命中X, 命中Y, 动作名)
    End If
End Function



