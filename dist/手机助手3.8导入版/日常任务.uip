        文字框:{名称:"标题",提示内容:"最小闭环 v0.2：QQ自动授权 → 邮件检查 → 返回大厅",文字大小:16},
        文字框:{名称:"说明",提示内容:"请使用720×1280、320 DPI。使用当前QQ和已选区服，识别授权登录、同意及确认后自动点击。",文字大小:12},
        文字框:{名称:"操作说明",提示内容:"没有奖励也属于正常检查完成；只有返回大厅后才记录完成。",文字大小:12},
        输入框:{名称:"登录超时秒数",提示内容:"启动到进入主页超时（秒，包含QQ授权及加载，30～3600）",初始文本:"600",仅输入数字:true,最大输入长度:4},
        文字框:{名称:"登录计时说明",提示内容:"QQ授权、确认及返回游戏共用此期限；未超时不会因切换前台而重启。",文字大小:12},
        输入框:{名称:"操作超时秒数",提示内容:"任务操作无进展超时（秒，不用于登录过程）",初始文本:"120",仅输入数字:true,最大输入长度:4},
        输入框:{名称:"邮件间隔秒数",提示内容:"邮件检查间隔（秒，默认6小时，测试可填60）",初始文本:"21600",仅输入数字:true,最大输入长度:5},
        多选框:{名称:"立即检查邮件",提示内容:"本次启动立即检查，忽略已有等待时间",选中:false},
